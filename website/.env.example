# URL of the render-api backend
# Local dev:
# VITE_API_URL=http://localhost:3003

# Production:
VITE_API_URL=https://your-api.onrender.com

# Effect AI task-poster dataset/fetcher IDs
# These pre-fill the Phase 1 & 2 forms in SongList.vue
# Phase 1 — individual segment validation
VITE_EFFECT_PHASE1_DATASET_ID=your_phase1_dataset_id
VITE_EFFECT_PHASE1_FETCHER_INDEX=1

# Phase 2 — full song validation
VITE_EFFECT_PHASE2_DATASET_ID=your_phase2_dataset_id
VITE_EFFECT_PHASE2_FETCHER_INDEX=1
